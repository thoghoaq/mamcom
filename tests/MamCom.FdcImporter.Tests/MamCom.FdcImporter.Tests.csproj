<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\tools\MamCom.FdcImporter\MamCom.FdcImporter.csproj" />
    <!-- SchemaSet checks the suggestion files against their schema. -->
    <ProjectReference Include="..\..\tools\MamCom.DataBuilder\MamCom.DataBuilder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\schemas\*.json" Link="data\schemas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\seed\plan\*.csv" Link="data\plan\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\seed\ingredients\*.json" Link="data\ingredients\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The suggestion files from a real run (PLAN 2.3), kept apart from the data folder the tests copy and write into. -->
    <None Include="..\fixtures\seed\_suggestions\nutrition\*.json" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
