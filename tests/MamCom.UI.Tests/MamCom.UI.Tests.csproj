<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MamCom.UI\MamCom.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The files of MamCom.UI the tests read as text or bytes: the stylesheets, the icon sprite and the fonts. -->
    <None Include="..\..\src\MamCom.UI\wwwroot\*.css" Link="wwwroot\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\MamCom.UI\wwwroot\icons\*.svg" Link="wwwroot\icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\MamCom.UI\wwwroot\fonts\*" Link="wwwroot\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The frozen seed (ADR-018): which categories and protein sources the placeholders must know. -->
    <None Include="..\fixtures\seed\ingredients\*.json" Link="seed\ingredients\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\seed\dishes\*.json" Link="seed\dishes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bunit" />
  </ItemGroup>

</Project>
