<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\MamCom.Studio\MamCom.Studio.csproj" />
    <ProjectReference Include="..\..\tools\MamCom.DataBuilder\MamCom.DataBuilder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The data folder the tests see: the live schemas and config (so a change to them is checked) and the frozen seed in
         tests/fixtures/seed for everything Studio edits (ingredients, dishes, plan, suggestions), so approving a dish or confirming
         an ingredient in the real data does not change what a test sees (ADR-018). -->
    <None Include="..\..\data\schemas\*.json" Link="data\schemas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\config\*.json" Link="data\config\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\seed\ingredients\*.json" Link="data\ingredients\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\seed\dishes\*.json" Link="data\dishes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\seed\_suggestions\nutrition\*.json" Link="data\_suggestions\nutrition\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bunit" />
  </ItemGroup>

</Project>
