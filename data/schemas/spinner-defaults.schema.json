{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spinner defaults",
  "description": "data/config/spinner-defaults.json (SPEC 5). The bounds are guard rails against typos; relations (reducedUntilDays not below excludeWithinDays) are checked by SpinnerConfig.Validate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "secondMainMinBaseServings",
    "attemptsPerLevel",
    "historySize",
    "recency",
    "preference",
    "seasonMatchWeight",
    "regionMatchWeight",
    "maxFriedDishes",
    "seasonByMonth"
  ],
  "properties": {
    "secondMainMinBaseServings": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
    "attemptsPerLevel": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "historySize": { "type": "integer", "minimum": 1, "maximum": 50 },
    "recency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excludeWithinDays", "reducedUntilDays", "reducedWeight"],
      "properties": {
        "excludeWithinDays": { "type": "integer", "minimum": 0, "maximum": 30 },
        "reducedUntilDays": { "type": "integer", "minimum": 0, "maximum": 90 },
        "reducedWeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liked", "neutral", "disliked"],
      "properties": {
        "liked": { "$ref": "#/$defs/weight" },
        "neutral": { "$ref": "#/$defs/weight" },
        "disliked": { "$ref": "#/$defs/weight" }
      }
    },
    "seasonMatchWeight": { "$ref": "#/$defs/weight" },
    "regionMatchWeight": { "$ref": "#/$defs/weight" },
    "maxFriedDishes": { "type": "integer", "minimum": 0, "maximum": 4 },
    "seasonByMonth": {
      "description": "Season id for January to December. Dishes name seasons with these ids.",
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "not": { "const": "all" } }
    }
  },
  "$defs": {
    "weight": {
      "description": "A weight is never zero: a dish must not become impossible to draw because of it.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    }
  }
}
