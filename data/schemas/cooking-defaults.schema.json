{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cooking defaults",
  "description": "data/config/cooking-defaults.json (SPEC 5.6): the rice pseudo-dish that opens every cook plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["riceActiveMinutes", "ricePassiveMinutes", "riceStepText"],
  "properties": {
    "riceActiveMinutes": { "type": "integer", "minimum": 0, "maximum": 60 },
    "ricePassiveMinutes": { "type": "integer", "minimum": 0, "maximum": 240 },
    "riceStepText": { "type": "string", "minLength": 1 }
  }
}
