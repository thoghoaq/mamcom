        "hanh-la"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm hành tím với dầu ăn rồi cho tôm vào xào đến khi tôm đỏ.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
