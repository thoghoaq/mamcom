  "steps": [
    {
      "order": 1,
      "text": "Thái ba chỉ mỏng rồi ướp với một nửa hành tím, tỏi, nước mắm, đường, tiêu và nước màu.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-ba-chi",
        "hanh-tim",
        "toi",
        "nuoc-mam",
        "duong",
        "hat-tieu",
        "nuoc-mau"
      ]
    },
    {
      "order": 2,
      "text": "Trộn thịt bằm với phần hành tím và gia vị ướp còn lại, vo thành viên dẹt.",
      "activeMinutes": 7,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-nac-bam",
        "hanh-tim",
        "nuoc-mam",
        "duong",
        "hat-tieu"
      ]
    },
    {
      "order": 3,
      "text": "Để thịt ngấm gia vị.",
      "activeMinutes": 0,
      "passiveMinutes": 30,
      "ingredientIds": [
        "thit-ba-chi",
        "thit-nac-bam"
      ]
    },
    {
      "order": 4,
      "text": "Ngâm cà rốt và củ cải thái mỏng với chút giấm và đường cho thành đồ chua.",
      "activeMinutes": 5,
      "passiveMinutes": 15,
      "ingredientIds": [
        "ca-rot",
        "giam",
        "duong",
        "cu-cai"
      ]
    },
    {
      "order": 5,
      "text": "Pha nước chấm với nước mắm, đường, giấm, nước ấm, rồi cho tỏi băm và ớt vào.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "duong",
        "giam",
        "toi",
        "ot"
      ]
    },
    {
      "order": 6,
      "text": "Trần bún qua nước sôi cho mềm, rửa và để ráo rau sống.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "bun",
        "xa-lach",
        "rau-thom"
      ]
    },
    {
      "order": 7,
      "text": "Quét dầu lên thịt rồi nướng trên than hoặc lò, trở đều đến khi xém cạnh.",
      "activeMinutes": 15,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-ba-chi",
        "thit-nac-bam",
        "dau-an"
      ]
    },
    {
      "order": 8,
      "text": "Thả chả nóng và đồ chua vào bát nước chấm, dọn ngay cùng bún và rau.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-ba-chi",
        "thit-nac-bam",
        "ca-rot",
        "bun",
        "xa-lach",
        "rau-thom"
      ]
    }
