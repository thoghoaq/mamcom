  "steps": [
    {
      "order": 1,
      "text": "Rửa xương ống, chần sơ trong nước sôi rồi đổ nước, rửa lại cho sạch.",
      "activeMinutes": 5,
      "passiveMinutes": 5,
      "ingredientIds": [
        "xuong-ong-heo"
      ]
    },
    {
      "order": 2,
      "text": "Cho xương, củ cải và tôm khô vào nồi nước, ninh lửa nhỏ, thỉnh thoảng hớt bọt.",
      "activeMinutes": 5,
      "passiveMinutes": 90,
      "ingredientIds": [
        "xuong-ong-heo",
        "cu-cai",
        "tom-kho"
      ]
    },
    {
      "order": 3,
      "text": "Thả miếng thịt nạc vào nồi nước dùng luộc chín, vớt ra để nguội rồi thái mỏng.",
      "activeMinutes": 5,
      "passiveMinutes": 15,
      "ingredientIds": [
        "thit-heo-nac"
      ]
    },
    {
      "order": 4,
      "text": "Phi tỏi băm với dầu ăn đến vàng thơm, múc riêng ra chén.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "toi",
        "dau-an"
      ]
    },
    {
      "order": 5,
      "text": "Xào thịt bằm với một ít nước mắm và tiêu đến khi chín tơi.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-nac-bam",
        "nuoc-mam",
        "hat-tieu"
      ]
    },
    {
      "order": 6,
      "text": "Nêm nước dùng với nước mắm, hạt nêm, đường và muối cho vừa, giữ sôi lăn tăn.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "hat-nem",
        "duong",
        "muoi"
      ]
    },
    {
      "order": 7,
      "text": "Chần tôm trong nước dùng đến vừa chín rồi vớt ra.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "tom"
      ]
    },
    {
      "order": 8,
      "text": "Trụng hủ tiếu và giá trong nước sôi, để ráo rồi cho vào tô.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hu-tieu",
        "gia-do"
      ]
    },
    {
      "order": 9,
      "text": "Xếp thịt thái, thịt bằm, tôm lên mặt, chan nước dùng thật nóng, rắc hẹ, cần tây, hành phi, tỏi phi và tiêu.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-heo-nac",
        "thit-nac-bam",
        "tom",
        "he",
        "can-tay",
        "hanh-phi",
        "toi",
        "hat-tieu"
      ]
    },
    {
      "order": 10,
      "text": "Dọn ngay kèm xà lách, chanh và ớt để riêng.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "xa-lach",
        "chanh",
        "ot"
      ]
    }
  ],
