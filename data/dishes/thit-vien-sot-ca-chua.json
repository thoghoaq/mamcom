  "steps": [
    {
      "order": 1,
      "text": "Bóc và băm hành tím, tỏi; thái hạt lựu cà chua; thái nhỏ hành lá.",
      "activeMinutes": 7,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-tim",
        "toi",
        "ca-chua",
        "hanh-la"
      ]
    },
    {
      "order": 2,
      "text": "Trộn thịt bằm với một nửa hành tím, bột năng, nửa phần nước mắm, hạt nêm và hạt tiêu rồi để thấm.",
      "activeMinutes": 3,
      "passiveMinutes": 15,
      "ingredientIds": [
        "thit-nac-bam",
        "hanh-tim",
        "bot-nang",
        "nuoc-mam",
        "hat-nem",
        "hat-tieu"
      ]
    },
    {
      "order": 3,
      "text": "Vo thịt thành viên cỡ ngón tay cái.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-nac-bam"
      ]
    },
    {
      "order": 4,
      "text": "Đun nóng dầu, chiên thịt viên lửa vừa cho vàng đều các mặt rồi vớt ra.",
      "activeMinutes": 7,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "thit-nac-bam"
      ]
    },
    {
      "order": 5,
      "text": "Phi thơm tỏi và phần hành tím còn lại với dầu còn trong chảo, cho cà chua vào đảo đến khi nhừ.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "toi",
        "hanh-tim",
        "ca-chua",
        "dau-an"
      ]
    },
    {
      "order": 6,
      "text": "Thêm tương cà, đường, phần nước mắm còn lại và một ít nước, khuấy đều cho sốt sôi.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "tuong-ca",
        "duong",
        "nuoc-mam"
      ]
    },
    {
      "order": 7,
      "text": "Thả thịt viên vào sốt, đậy nắp rim lửa nhỏ cho viên thấm và sốt sánh lại.",
      "activeMinutes": 1,
      "passiveMinutes": 10,
      "ingredientIds": [
        "thit-nac-bam"
      ]
    },
    {
      "order": 8,
      "text": "Nêm lại cho vừa, rắc hành lá rồi tắt bếp.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-la"
      ]
    }
  ],
