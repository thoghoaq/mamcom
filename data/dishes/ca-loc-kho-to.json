        "toi",
        "hat-tieu"
      ]
    },
    {
      "order": 3,
      "text": "Cho dầu và phần đường còn lại vào tộ, đun lửa nhỏ đến khi đường chuyển màu cánh gián.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "duong"
      ]
    },
    {
      "order": 4,
      "text": "Phi thơm phần hành tím còn lại trong nước màu, xếp cá vào, đổ nước dừa và thả ớt.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-tim",
        "ca-loc",
        "ot"
      ]
    },
    {
      "order": 5,
      "text": "Kho liu riu lửa nhỏ đến khi nước sánh lại, thỉnh thoảng rưới nước kho lên cá.",
      "activeMinutes": 3,
      "passiveMinutes": 25,
      "ingredientIds": [
        "ca-loc"
      ]
    },
    {
      "order": 6,
      "text": "Nêm lại vừa ăn, rắc hành lá và thêm tiêu rồi tắt bếp.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
