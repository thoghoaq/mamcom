  "steps": [
    {
      "order": 1,
      "text": "Rửa sạch xương ống, chân giò và bắp bò rồi chần qua nước sôi, vớt ra rửa lại.",
      "activeMinutes": 10,
      "passiveMinutes": 5,
      "ingredientIds": [
        "xuong-ong-heo",
        "thit-bo-bap",
        "gio-heo"
      ]
    },
    {
      "order": 2,
      "text": "Cho xương vào nồi nước cùng sả đập và hành tím, ninh lửa nhỏ, thỉnh thoảng hớt bọt.",
      "activeMinutes": 5,
      "passiveMinutes": 60,
      "ingredientIds": [
        "xuong-ong-heo",
        "sa",
        "hanh-tim"
      ]
    },
    {
      "order": 3,
      "text": "Thả bắp bò và chân giò vào nồi, ninh tiếp đến khi thịt mềm.",
      "activeMinutes": 3,
      "passiveMinutes": 45,
      "ingredientIds": [
        "thit-bo-bap",
        "gio-heo"
      ]
    },
    {
      "order": 4,
      "text": "Hòa mắm ruốc với nước, để lắng rồi chắt phần nước trong vào nồi.",
      "activeMinutes": 3,
      "passiveMinutes": 10,
      "ingredientIds": [
        "mam-ruoc"
      ]
    },
    {
      "order": 5,
      "text": "Phi thơm tỏi, sả băm và ớt với dầu ăn để làm sa tế.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "toi",
        "sa",
        "ot"
      ]
    },
    {
      "order": 6,
      "text": "Nêm nước dùng với nước mắm, đường, muối, hạt nêm và một phần sa tế cho vừa vị.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "duong",
        "muoi",
        "hat-nem"
      ]
    },
    {
      "order": 7,
      "text": "Vớt bắp bò ra để nguội bớt rồi thái lát mỏng, thái chả lụa và chân giò.",
      "activeMinutes": 8,
      "passiveMinutes": 5,
      "ingredientIds": [
        "thit-bo-bap",
        "cha-lua",
        "gio-heo"
      ]
    },
    {
      "order": 8,
      "text": "Trụng bún qua nước sôi, cho vào tô, xếp thịt, chả, hành lá, hành tây rồi chan nước dùng thật nóng.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "bun",
        "thit-bo-bap",
        "cha-lua",
        "hanh-la",
        "hanh-tay"
      ]
    },
    {
      "order": 9,
      "text": "Dọn kèm giá, rau thơm, chanh và sa tế để mỗi người tự thêm.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "gia-do",
        "rau-thom",
        "chanh"
      ]
    }
  ],
