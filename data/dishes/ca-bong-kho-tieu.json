  "steps": [
    {
      "order": 1,
      "text": "Chà cá bống với muối cho hết nhớt, rửa sạch và để ráo.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-bong",
