      ]
    },
    {
      "order": 2,
      "text": "Ướp cá với nước mắm, đường, nước màu, một nửa hành tỏi băm và một nửa tiêu.",
      "activeMinutes": 3,
      "passiveMinutes": 20,
      "ingredientIds": [
