        "nuoc-mau",
        "hanh-tim",
        "toi",
        "hat-tieu"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm phần hành tỏi còn lại với dầu ăn trong nồi đất.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "toi"
      ]
    },
    {
      "order": 4,
      "text": "Xếp cá vào nồi, đổ nước ướp và chút nước sâm sấp, thêm ớt rồi đun lửa nhỏ.",
      "activeMinutes": 3,
      "passiveMinutes": 20,
      "ingredientIds": [
        "ca-bong",
        "ot"
      ]
    },
    {
      "order": 5,
      "text": "Trở nhẹ cá, rim đến khi nước sánh keo, rắc phần tiêu còn lại và hành lá rồi tắt bếp.",
      "activeMinutes": 5,
