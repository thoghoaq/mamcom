  "steps": [
    {
      "order": 1,
      "text": "Cắt bò thành khối vuông, ướp với nửa phần tỏi, dầu hào, nước tương, đường và tiêu.",
      "activeMinutes": 5,
      "passiveMinutes": 20,
      "ingredientIds": [
        "thit-bo-than",
        "toi",
        "dau-hao",
        "nuoc-tuong",
        "duong",
        "hat-tieu"
      ]
    },
    {
      "order": 2,
      "text": "Trong lúc chờ, cắt ớt chuông, hành tây; xếp xà lách và cà chua thái lát ra đĩa.",
      "activeMinutes": 6,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ot-chuong",
        "hanh-tay",
        "ca-chua",
        "xa-lach"
      ]
    },
    {
      "order": 3,
      "text": "Xào nhanh ớt chuông và hành tây với chút dầu trên lửa lớn rồi trút ra.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "ot-chuong",
        "hanh-tay"
      ]
    },
    {
      "order": 4,
      "text": "Đun nóng già dầu với bơ và tỏi còn lại, cho bò vào áp chảo rồi lắc chảo cho bò xém đều các mặt.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "bo",
        "toi",
        "thit-bo-than"
      ]
    },
    {
      "order": 5,
      "text": "Trút ớt chuông và hành tây trở lại chảo, lắc đều thêm nửa phút rồi tắt bếp.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ot-chuong",
        "hanh-tay"
      ]
    },
    {
      "order": 6,
      "text": "Pha muối, tiêu và nước chanh làm chén chấm, dọn bò ngay lên đĩa xà lách, cà chua.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
