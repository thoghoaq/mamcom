  "steps": [
    {
      "order": 1,
      "text": "Thái thịt bò, gọt và thái thơm, cắt hành tây, cà chua, hành lá, ớt, băm tỏi.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-bo",
        "thom",
        "hanh-tay",
        "ca-chua",
        "hanh-la",
        "ot",
        "toi",
        "rau-mui"
      ]
    },
    {
      "order": 2,
      "text": "Ướp bò với một nửa tỏi, nửa nước mắm, dầu hào, tiêu, bột năng và chút dầu ăn.",
      "activeMinutes": 2,
      "passiveMinutes": 15,
      "ingredientIds": [
        "thit-bo",
        "toi",
        "nuoc-mam",
        "dau-hao",
        "hat-tieu",
        "bot-nang",
        "dau-an"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm phần tỏi còn lại, xào bò lửa lớn đến khi vừa tái rồi trút ra đĩa.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "toi",
        "thit-bo"
      ]
    },
    {
      "order": 4,
      "text": "Xào thơm, hành tây và cà chua với đường và phần nước mắm còn lại đến khi hơi mềm.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thom",
        "hanh-tay",
        "ca-chua",
        "duong",
        "nuoc-mam"
      ]
    },
    {
      "order": 5,
      "text": "Cho bò trở lại chảo cùng hành lá và ớt, đảo nhanh rồi tắt bếp.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-bo",
        "hanh-la",
        "ot"
      ]
    },
    {
      "order": 6,
      "text": "Dọn ra đĩa, rắc rau mùi và tiêu, ăn nóng với cơm.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
