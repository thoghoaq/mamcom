  "steps": [
    {
      "order": 1,
      "text": "Chà cá với muối, rửa sạch rồi cắt khúc.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-dieu-hong",
        "muoi"
      ]
    },
    {
      "order": 2,
      "text": "Ướp cá với một ít nước mắm và hạt tiêu cho thấm.",
      "activeMinutes": 2,
      "passiveMinutes": 15,
      "ingredientIds": [
        "ca-dieu-hong",
        "nuoc-mam",
        "hat-tieu"
      ]
    },
    {
      "order": 3,
      "text": "Ngâm me với nước nóng rồi dầm, lọc lấy nước chua.",
      "activeMinutes": 2,
      "passiveMinutes": 10,
      "ingredientIds": [
        "me"
      ]
    },
    {
      "order": 4,
      "text": "Sơ chế và cắt các loại rau, củ, quả theo ghi chú.",
      "activeMinutes": 12,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-chua",
        "thom",
        "bac-ha",
        "dau-bap",
        "rau-muong",
        "gia-do",
        "rau-om",
        "ngo-gai",
        "ot"
      ]
    },
    {
      "order": 5,
      "text": "Phi thơm tỏi và hành tím với dầu, cho cà chua và thơm vào xào mềm.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "toi",
        "hanh-tim",
        "ca-chua",
        "thom"
      ]
    },
    {
      "order": 6,
      "text": "Đổ nước vào nồi, thêm nước me, nêm nước mắm, đường, hạt nêm cho vừa chua ngọt rồi đun sôi.",
      "activeMinutes": 3,
      "passiveMinutes": 10,
      "ingredientIds": [
        "me",
        "nuoc-mam",
        "duong",
        "hat-nem"
      ]
    },
    {
      "order": 7,
      "text": "Đặt nồi lên bếp lẩu, cho đậu bắp, bạc hà và cá vào nấu đến khi cá chín.",
      "activeMinutes": 3,
      "passiveMinutes": 6,
      "ingredientIds": [
        "dau-bap",
        "bac-ha",
        "ca-dieu-hong"
      ]
    },
    {
      "order": 8,
      "text": "Rắc rau om, ngò gai lên nồi và dọn kèm bún, rau muống, giá, ớt để nhúng ăn nóng.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "rau-om",
        "ngo-gai",
        "bun",
        "rau-muong",
        "gia-do",
        "ot"
      ]
    }
