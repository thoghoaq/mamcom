  "steps": [
    {
      "order": 1,
      "text": "Chần xương bò trong nước sôi có chút muối rồi rửa sạch.",
      "activeMinutes": 5,
      "passiveMinutes": 5,
      "ingredientIds": [
        "muoi",
        "xuong-bo"
      ]
    },
    {
      "order": 2,
      "text": "Nướng gừng, hành tím, nửa củ hành tây cho cháy vỏ rồi rang hồi, quế, thảo quả đến thơm.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "gung",
        "hanh-tim",
        "hanh-tay",
        "hoi",
        "que",
        "thao-qua"
      ]
    },
    {
      "order": 3,
      "text": "Cho xương, bắp bò và gừng hành nướng vào nồi nước, ninh lửa nhỏ, hớt bọt thường xuyên.",
      "activeMinutes": 10,
      "passiveMinutes": 60,
      "ingredientIds": [
        "thit-bo-bap",
        "gung",
        "hanh-tim",
        "hanh-tay",
        "xuong-bo"
      ]
    },
    {
      "order": 4,
      "text": "Vớt bắp bò ngâm nước nguội, thả túi hồi quế thảo quả vào nồi và ninh tiếp lửa liu riu.",
      "activeMinutes": 5,
      "passiveMinutes": 120,
      "ingredientIds": [
        "thit-bo-bap",
        "hoi",
        "que",
        "thao-qua"
      ]
    },
    {
      "order": 5,
      "text": "Lọc nước dùng, nêm nước mắm, muối, đường cho vừa và giữ sôi lăn tăn.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "muoi",
        "duong"
      ]
    },
    {
      "order": 6,
      "text": "Thái mỏng thăn bò, bắp bò, hành tây còn lại; thái hành lá, rau mùi, ớt và cắt chanh.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-bo-than",
        "thit-bo-bap",
        "hanh-tay",
        "hanh-la",
        "rau-mui",
        "ot",
        "chanh"
      ]
    },
    {
      "order": 7,
      "text": "Trụng bánh phở cho vào tô, xếp bắp bò, thăn bò tái, hành tây, chan nước dùng thật sôi rồi rắc hành lá, rau mùi, tiêu.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "banh-pho",
        "thit-bo-bap",
        "thit-bo-than",
        "hanh-tay",
        "hanh-la",
        "rau-mui",
        "hat-tieu"
      ]
    },
    {
      "order": 8,
      "text": "Dọn ngay kèm giá, ngò gai, chanh và ớt.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "gia-do",
        "ngo-gai",
        "chanh",
        "ot"
      ]
    }
  ],
