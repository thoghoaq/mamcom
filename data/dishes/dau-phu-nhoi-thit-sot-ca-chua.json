  "steps": [
    {
      "order": 1,
      "text": "Trộn thịt bằm với mộc nhĩ, nửa phần hành tím, một ít nước mắm và hạt tiêu rồi để ngấm.",
      "activeMinutes": 5,
      "passiveMinutes": 10,
      "ingredientIds": [
        "thit-nac-bam",
        "moc-nhi",
        "hanh-tim",
        "nuoc-mam",
        "hat-tieu"
      ]
    },
    {
      "order": 2,
      "text": "Khoét rãnh giữa từng miếng đậu rồi nhồi nhân thịt vào cho chặt.",
      "activeMinutes": 7,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-phu"
      ]
    },
    {
      "order": 3,
      "text": "Chiên đậu nhồi trong dầu nóng, mặt có thịt xuống trước, đến khi vàng đều các mặt.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an"
      ]
    },
    {
      "order": 4,
      "text": "Phi thơm phần hành tím còn lại và đầu hành lá, cho cà chua vào xào nhừ thành sốt, nêm nước mắm, đường, muối.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-tim",
        "hanh-la",
        "ca-chua",
        "nuoc-mam",
        "duong",
        "muoi",
        "dau-an"
      ]
    },
    {
      "order": 5,
      "text": "Xếp đậu vào chảo sốt, đun nhỏ lửa cho đậu ngấm sốt và thịt chín kỹ.",
      "activeMinutes": 2,
      "passiveMinutes": 7,
      "ingredientIds": [
        "dau-phu",
        "ca-chua"
      ]
    },
    {
      "order": 6,
      "text": "Rắc hành lá và hạt tiêu lên rồi dọn ra ăn nóng.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-la",
        "hat-tieu"
      ]
    }
