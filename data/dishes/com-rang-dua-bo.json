  "steps": [
    {
      "order": 1,
      "text": "Vo gạo rồi nấu cơm, xới tơi và để nguội.",
      "activeMinutes": 3,
      "passiveMinutes": 30,
      "ingredientIds": [
        "gao"
      ]
    },
    {
      "order": 2,
      "text": "Ướp thịt bò với một nửa tỏi, nước mắm và hạt tiêu.",
      "activeMinutes": 3,
      "passiveMinutes": 10,
      "ingredientIds": [
        "thit-bo-than",
        "toi",
        "nuoc-mam",
        "hat-tieu"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm hành tím với ít dầu, cho dưa cải và cà chua vào xào, nêm chút đường rồi trút ra đĩa.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-tim",
        "dau-an",
        "dua-cai-chua",
        "ca-chua",
        "duong"
      ]
    },
    {
      "order": 4,
      "text": "Đun nóng chảo với ít dầu, xào thịt bò lửa lớn vừa tái thì trút ra.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-bo-than",
        "dau-an"
      ]
    },
    {
      "order": 5,
      "text": "Phi phần tỏi còn lại, cho cơm vào rang đến khi hạt cơm săn, đẩy cơm sang một bên rồi đổ trứng vào đảo đều với cơm.",
      "activeMinutes": 6,
      "passiveMinutes": 0,
      "ingredientIds": [
        "toi",
        "gao",
        "trung-ga",
        "dau-an"
      ]
    },
    {
      "order": 6,
      "text": "Cho dưa và thịt bò vào cơm, nêm hạt nêm, đảo nhanh rồi thêm hành lá, tắt bếp.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dua-cai-chua",
        "thit-bo-than",
        "hat-nem",
        "hanh-la"
      ]
    },
    {
      "order": 7,
      "text": "Múc cơm ra tô, rắc hạt tiêu và dọn kèm ớt thái lát ăn nóng.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hat-tieu",
        "ot"
      ]
    }
  ],
