        "hat-tieu"
      ]
    },
    {
      "order": 3,
      "text": "Lăn sườn qua bột năng rồi chiên trong dầu nóng đến khi vàng đều, vớt ra.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "suon-non",
        "bot-nang",
        "dau-an"
      ]
    },
    {
      "order": 4,
      "text": "Pha đường, giấm, tương cà với vài thìa nước thành nước sốt.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "duong",
        "giam",
        "tuong-ca"
      ]
    },
    {
      "order": 5,
      "text": "Phi thơm phần hành tỏi còn lại với ít dầu, đổ nước sốt vào đun sệt.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-tim",
        "toi",
        "dau-an"
      ]
    },
    {
      "order": 6,
      "text": "Cho sườn vào đảo đều trên lửa vừa cho sốt bám quanh miếng sườn, rắc hành lá rồi dọn ngay.",
      "activeMinutes": 5,
