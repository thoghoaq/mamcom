  "steps": [
    {
      "order": 1,
      "text": "Làm sạch mực, khứa vảy rồng rồi cắt miếng vừa ăn.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "muc"
      ]
    },
    {
      "order": 2,
      "text": "Ướp mực với gừng, một nửa tỏi, nước mắm và hạt tiêu.",
      "activeMinutes": 2,
      "passiveMinutes": 10,
      "ingredientIds": [
        "muc",
        "gung",
        "toi",
        "nuoc-mam",
        "hat-tieu"
      ]
    },
    {
      "order": 3,
      "text": "Cắt cần tây, hành lá, bổ hành tây và thái ớt trong lúc chờ ướp.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "can-tay",
        "hanh-la",
        "hanh-tay",
        "ot"
      ]
    },
    {
      "order": 4,
      "text": "Phi thơm phần tỏi còn lại với dầu, cho mực vào xào lửa lớn đến khi vừa săn rồi trút ra đĩa.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "toi",
        "muc"
      ]
    },
    {
      "order": 5,
      "text": "Xào hành tây và cần tây lửa lớn khoảng hai phút.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-tay",
        "can-tay"
      ]
    },
    {
      "order": 6,
      "text": "Cho mực trở lại chảo, nêm dầu hào và đường, thêm hành lá và ớt, đảo nhanh rồi tắt bếp dọn ngay.",
      "activeMinutes": 2,
