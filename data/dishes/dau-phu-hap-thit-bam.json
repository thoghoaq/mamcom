      ]
    },
    {
      "order": 3,
      "text": "Cắt đậu phụ thành miếng, xếp vào đĩa sâu lòng rồi phủ đều thịt lên trên.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-phu",
        "thit-nac-bam"
      ]
    },
    {
      "order": 4,
      "text": "Hấp đĩa đậu trong nồi nước sôi đến khi thịt chín.",
      "activeMinutes": 1,
      "passiveMinutes": 15,
      "ingredientIds": [
        "dau-phu",
        "thit-nac-bam"
      ]
    },
    {
      "order": 5,
      "text": "Phi thơm hành tím còn lại với dầu ăn, thêm dầu hào và chút nước hấp trong đĩa, đun sệt.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "dau-hao"
      ]
    },
    {
      "order": 6,
      "text": "Rưới nước sốt lên đậu, rắc hành lá và dọn ngay khi còn nóng.",
      "activeMinutes": 1,
