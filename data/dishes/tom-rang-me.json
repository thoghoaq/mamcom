        "duong",
        "nuoc-mam"
      ]
    },
    {
      "order": 4,
      "text": "Phi thơm phần tỏi và hành tím còn lại với dầu ăn, cho tôm vào rang lửa lớn đến khi tôm đỏ.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "toi",
        "hanh-tim",
        "tom"
      ]
    },
    {
      "order": 5,
      "text": "Đổ hỗn hợp nước me vào, đảo đều đến khi sốt sệt bám quanh tôm.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "tom",
        "me",
        "duong",
        "nuoc-mam"
      ]
    },
    {
      "order": 6,
      "text": "Rắc hành lá và ớt, đảo nhanh rồi tắt bếp, dọn ra ăn nóng.",
