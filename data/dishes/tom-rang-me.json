        "hanh-tim"
      ]
    },
    {
      "order": 3,
      "text": "Ngâm me với chút nước ấm, dầm kỹ rồi lọc lấy nước cốt, khuấy cùng đường và nước mắm.",
      "activeMinutes": 4,
      "passiveMinutes": 5,
      "ingredientIds": [
