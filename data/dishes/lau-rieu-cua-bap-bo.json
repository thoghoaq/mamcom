  "steps": [
    {
      "order": 1,
      "text": "Rửa sạch cua, tách mai lấy gạch để riêng, giã thân cua với chút muối rồi lọc lấy nước.",
      "activeMinutes": 15,
      "passiveMinutes": 0,
      "ingredientIds": [
        "cua-dong",
        "muoi"
      ]
    },
    {
      "order": 2,
      "text": "Đun nước cua lửa vừa, khuấy nhẹ một chiều đến khi riêu đóng mảng thì vặn nhỏ lửa.",
      "activeMinutes": 5,
      "passiveMinutes": 10,
      "ingredientIds": [
        "cua-dong"
      ]
    },
    {
      "order": 3,
      "text": "Chiên đậu phụ vàng đều các mặt rồi vớt ra.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-phu",
        "dau-an"
      ]
    },
    {
      "order": 4,
      "text": "Phi thơm hành tím, cho gạch cua và cà chua vào xào mềm.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-tim",
        "dau-an",
        "cua-dong",
        "ca-chua"
      ]
    },
    {
      "order": 5,
      "text": "Đổ phần cà chua xào và đậu vào nồi riêu, nêm mắm tôm, nước mắm, hạt nêm và giấm cho vừa chua.",
      "activeMinutes": 3,
      "passiveMinutes": 5,
      "ingredientIds": [
        "ca-chua",
        "dau-phu",
        "mam-tom",
        "nuoc-mam",
        "hat-nem",
        "giam"
      ]
    },
    {
      "order": 6,
      "text": "Ướp bắp bò thái mỏng với hạt tiêu và vài giọt nước mắm.",
      "activeMinutes": 5,
      "passiveMinutes": 5,
      "ingredientIds": [
        "thit-bo-bap",
        "hat-tieu",
        "nuoc-mam"
      ]
    },
    {
      "order": 7,
      "text": "Rửa và để ráo rau muống, hành lá và ớt.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "rau-muong",
        "hanh-la",
        "ot"
      ]
    },
    {
      "order": 8,
      "text": "Trụng bún qua nước sôi rồi để ráo.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "bun"
      ]
    },
    {
      "order": 9,
      "text": "Đặt nồi lẩu lên bếp, rắc hành lá, nhúng bắp bò và rau chín tới rồi ăn cùng bún và ớt.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-bo-bap",
        "rau-muong",
        "hanh-la",
        "bun",
        "ot"
      ]
    }
  ],
