        "hanh-la"
      ]
    },
    {
      "order": 3,
      "text": "Chiên đậu phụ trong dầu nóng đến khi vàng đều các mặt rồi vớt ra.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
