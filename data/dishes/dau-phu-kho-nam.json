        "dau-an",
        "nam-huong",
        "nam-rom"
      ]
    },
    {
      "order": 5,
      "text": "Cho đậu phụ vào, nêm nước tương, dầu hào, đường, hạt nêm và thêm ít nước, đảo nhẹ cho đều.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-phu",
        "nuoc-tuong",
        "dau-hao",
        "duong",
        "hat-nem"
      ]
    },
    {
      "order": 6,
      "text": "Đun lửa nhỏ, kho đến khi nước sánh lại và đậu thấm màu.",
      "activeMinutes": 1,
      "passiveMinutes": 12,
      "ingredientIds": [
