        "dau-an"
      ]
    },
    {
      "order": 4,
      "text": "Phi thơm hành tím và tỏi với chút dầu còn lại, cho nấm hương và nấm rơm vào xào săn.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
