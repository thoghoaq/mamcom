  "steps": [
    {
      "order": 1,
      "text": "Chần xương ống và sườn non qua nước sôi rồi rửa sạch.",
      "activeMinutes": 5,
      "passiveMinutes": 5,
      "ingredientIds": [
        "xuong-ong-heo",
        "suon-non"
      ]
    },
    {
      "order": 2,
      "text": "Ninh xương và sườn với hành tím nướng, chút muối, vớt bọt thường xuyên.",
      "activeMinutes": 5,
      "passiveMinutes": 60,
      "ingredientIds": [
        "xuong-ong-heo",
        "suon-non",
        "hanh-tim",
        "muoi"
      ]
    },
    {
      "order": 3,
      "text": "Ngâm nấm hương và mộc nhĩ cho nở rồi băm nhỏ.",
      "activeMinutes": 5,
      "passiveMinutes": 15,
      "ingredientIds": [
        "nam-huong",
        "moc-nhi"
      ]
    },
    {
      "order": 4,
      "text": "Trộn giò sống với nấm, mộc nhĩ, một ít nước mắm và hạt tiêu, để nghỉ cho ngấm.",
      "activeMinutes": 5,
      "passiveMinutes": 10,
      "ingredientIds": [
        "gio-song",
        "nam-huong",
        "moc-nhi",
        "nuoc-mam",
        "hat-tieu"
      ]
    },
    {
      "order": 5,
      "text": "Vo mọc thành viên nhỏ, thả vào nồi nước dùng đang sôi và nấu đến khi viên nổi lên.",
      "activeMinutes": 8,
      "passiveMinutes": 5,
      "ingredientIds": [
        "gio-song"
      ]
    },
    {
      "order": 6,
      "text": "Nêm nước dùng bằng hạt nêm và nước mắm cho vừa, thái chả lụa.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hat-nem",
        "nuoc-mam",
        "cha-lua"
      ]
    },
    {
      "order": 7,
      "text": "Chần bún cho vào tô, xếp mọc, sườn, chả, rắc hành lá, rau mùi, chan nước dùng nóng, dọn kèm ớt và chanh.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "bun",
        "gio-song",
        "suon-non",
        "cha-lua",
        "hanh-la",
        "rau-mui",
        "ot",
        "chanh"
      ]
    }
  ],
