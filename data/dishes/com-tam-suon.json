  "steps": [
    {
      "order": 1,
      "text": "Vo gạo (gạo tấm nếu có), cho nước vừa đủ rồi bấm nồi cơm.",
      "activeMinutes": 3,
      "passiveMinutes": 25,
      "ingredientIds": [
        "gao"
      ]
    },
    {
      "order": 2,
      "text": "Ướp sườn với sả, tỏi, hành tím, nước mắm, đường, tiêu, nước màu và chút dầu ăn.",
      "activeMinutes": 8,
      "passiveMinutes": 30,
      "ingredientIds": [
        "suon-heo",
        "sa",
        "toi",
        "hanh-tim",
        "nuoc-mam",
        "duong",
        "hat-tieu",
        "nuoc-mau",
        "dau-an"
      ]
    },
    {
      "order": 3,
      "text": "Trộn cà rốt và củ cải với giấm, đường để làm đồ chua.",
      "activeMinutes": 5,
      "passiveMinutes": 20,
      "ingredientIds": [
        "ca-rot",
        "cu-cai",
        "giam",
        "duong"
      ]
    },
    {
      "order": 4,
      "text": "Nướng sườn trên than hoặc lò đến khi vàng xém hai mặt, trở đều tay.",
      "activeMinutes": 10,
      "passiveMinutes": 5,
      "ingredientIds": [
        "suon-heo"
      ]
    },
    {
      "order": 5,
      "text": "Đun nóng dầu rồi rưới lên hành lá để làm mỡ hành.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-la",
        "dau-an"
      ]
    },
    {
      "order": 6,
      "text": "Pha nước mắm với đường, nước cốt chanh, tỏi và ớt cho vừa miệng.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "duong",
        "chanh",
        "toi",
        "ot"
      ]
    },
    {
      "order": 7,
      "text": "Xới cơm ra đĩa, đặt sườn lên, rưới mỡ hành, kèm dưa leo, cà chua, đồ chua và nước mắm.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "suon-heo",
        "hanh-la",
        "dua-leo",
        "ca-chua",
        "ca-rot",
        "cu-cai",
        "nuoc-mam"
      ]
    }
  ],
