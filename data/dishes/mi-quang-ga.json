  "steps": [
    {
      "order": 1,
      "text": "Ướp gà với nước nghệ, một nửa hành tím, tỏi, nước mắm, hạt nêm, đường và tiêu.",
      "activeMinutes": 5,
      "passiveMinutes": 20,
      "ingredientIds": [
        "ga-ta",
        "nghe",
        "hanh-tim",
        "toi",
        "nuoc-mam",
        "hat-nem",
        "duong",
        "hat-tieu"
      ]
    },
    {
      "order": 2,
      "text": "Rang lạc trên chảo khô đến khi thơm, xát vỏ rồi giã dập.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "lac"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm phần hành tím còn lại với dầu, cho gà vào xào đến khi săn và thấm màu vàng.",
      "activeMinutes": 7,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "ga-ta"
      ]
    },
    {
      "order": 4,
      "text": "Đổ nước xâm xấp, đun liu riu cho gà mềm và nước dùng đậm.",
      "activeMinutes": 2,
      "passiveMinutes": 20,
      "ingredientIds": [
        "ga-ta"
      ]
    },
    {
      "order": 5,
      "text": "Nêm lại nước dùng cho vừa miệng rồi thả hành lá và tắt bếp.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "hanh-la"
      ]
    },
    {
      "order": 6,
      "text": "Rửa và để ráo xà lách, rau thơm, giá đỗ rồi xếp dưới đáy tô.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "xa-lach",
        "rau-thom",
        "gia-do"
      ]
    },
    {
      "order": 7,
      "text": "Trụng sợi mì Quảng (hoặc bánh phở) qua nước sôi, để ráo rồi cho lên trên lớp rau.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "banh-pho"
      ]
    },
    {
      "order": 8,
      "text": "Xếp gà lên mì, chan ít nước dùng, rắc lạc, rau mùi, dọn kèm ớt và chanh.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ga-ta",
        "lac",
        "rau-mui",
        "ot",
        "chanh"
      ]
    }
  ],
