  "steps": [
    {
      "order": 1,
      "text": "Vo gạo, cho vào nồi với khoảng 600 ml nước rồi đun sôi.",
      "activeMinutes": 3,
      "passiveMinutes": 5,
      "ingredientIds": [
        "gao"
      ]
    },
    {
      "order": 2,
      "text": "Hạ lửa nhỏ, ninh cháo đến khi hạt gạo nở bung, thỉnh thoảng khuấy để khỏi dính đáy.",
      "activeMinutes": 2,
      "passiveMinutes": 20,
      "ingredientIds": [
        "gao"
      ]
    },
    {
      "order": 3,
      "text": "Ướp thịt bằm với một nửa nước mắm, một ít hạt tiêu và hành tím băm.",
      "activeMinutes": 2,
      "passiveMinutes": 10,
      "ingredientIds": [
        "thit-nac-bam",
        "nuoc-mam",
        "hat-tieu",
        "hanh-tim"
      ]
    },
    {
      "order": 4,
      "text": "Phi thơm phần hành tím còn lại với dầu ăn, cho thịt vào xào săn.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "thit-nac-bam"
      ]
    },
    {
      "order": 5,
      "text": "Trút thịt vào nồi cháo, khuấy tơi và nấu thêm cho thịt chín mềm.",
      "activeMinutes": 2,
      "passiveMinutes": 3,
      "ingredientIds": [
        "thit-nac-bam"
      ]
    },
    {
      "order": 6,
      "text": "Nêm hạt nêm và nước mắm còn lại cho vừa ăn.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hat-nem",
        "nuoc-mam"
      ]
    },
    {
      "order": 7,
      "text": "Rót trứng thành vòng vào cháo đang sôi, khuấy nhẹ cho trứng chín thành sợi rồi tắt bếp.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "trung-ga"
      ]
    },
    {
      "order": 8,
      "text": "Múc cháo ra bát, rắc hành lá, rau mùi và hạt tiêu, ăn ngay khi còn nóng.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-la",
        "rau-mui",
        "hat-tieu"
      ]
    }
  ],
