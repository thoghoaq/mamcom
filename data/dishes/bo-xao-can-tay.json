    },
    {
      "order": 2,
      "text": "Ướp thịt bò với một nửa tỏi, dầu hào, hạt tiêu, bột năng và chút dầu ăn.",
      "activeMinutes": 2,
      "passiveMinutes": 15,
      "ingredientIds": [
        "thit-bo-than",
        "toi",
        "dau-hao",
        "hat-tieu",
        "bot-nang",
        "dau-an"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm phần tỏi còn lại, xào bò lửa lớn đến khi vừa tái rồi trút ra đĩa.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "toi",
        "thit-bo-than"
      ]
    },
    {
      "order": 4,
      "text": "Xào cần tây và hành tây lửa lớn cho vừa chín tới, nêm nước mắm và đường.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "can-tay",
        "hanh-tay",
        "nuoc-mam",
        "duong"
      ]
    },
    {
      "order": 5,
      "text": "Cho bò trở lại chảo, đảo nhanh cho đều rồi tắt bếp, dọn ngay khi còn nóng.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
