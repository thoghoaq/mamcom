        "hat-tieu"
      ]
    },
    {
      "order": 2,
      "text": "Sơ chế cà chua, dứa, hành tây, ớt chuông, tỏi, ớt và rau thơm trong lúc chờ cá thấm.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-chua",
        "thom",
        "hanh-tay",
        "ot-chuong",
        "toi",
        "ot",
        "hanh-la",
        "rau-mui"
      ]
    },
    {
      "order": 3,
      "text": "Pha tương cà, đường, giấm, nước mắm với một ít nước thành chén sốt.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "tuong-ca",
        "duong",
        "giam",
        "nuoc-mam"
      ]
    },
    {
      "order": 4,
      "text": "Lăn cá qua bột năng rồi chiên vàng giòn hai mặt, vớt ra đĩa.",
      "activeMinutes": 12,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-dieu-hong",
        "bot-nang",
        "dau-an"
      ]
    },
    {
      "order": 5,
      "text": "Phi thơm tỏi, cho cà chua và dứa vào xào mềm rồi đổ chén sốt vào đun sánh.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "toi",
        "ca-chua",
        "thom",
        "tuong-ca",
        "duong",
        "giam",
        "nuoc-mam"
      ]
    },
    {
      "order": 6,
      "text": "Thả hành tây, ớt chuông và ớt vào đảo nhanh một phút cho vừa chín tới.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-tay",
        "ot-chuong",
        "ot"
      ]
    },
    {
      "order": 7,
      "text": "Rưới sốt lên cá, rắc hành lá và rau mùi rồi dọn ngay khi còn nóng.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-dieu-hong",
        "hanh-la",
        "rau-mui"
      ]
    }
