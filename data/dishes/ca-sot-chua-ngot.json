  "steps": [
    {
      "order": 1,
      "text": "Ướp cá với muối và tiêu khoảng 10 phút.",
      "activeMinutes": 2,
      "passiveMinutes": 10,
      "ingredientIds": [
        "ca-dieu-hong",
