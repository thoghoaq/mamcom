    },
    {
      "order": 2,
      "text": "Luộc hến với nước đến khi vỏ hé miệng, vớt ra tách lấy thịt, lọc nước luộc để lắng cặn.",
      "activeMinutes": 8,
      "passiveMinutes": 5,
      "ingredientIds": [
        "hen"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm hành tím với dầu ăn, cho thịt hến vào xào với chút nước mắm.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "hen",
        "nuoc-mam"
      ]
    },
    {
      "order": 4,
      "text": "Cho cà chua vào xào mềm rồi đổ nước luộc hến đã lọc vào đun sôi.",
      "activeMinutes": 3,
      "passiveMinutes": 4,
      "ingredientIds": [
        "ca-chua"
      ]
    },
    {
      "order": 5,
      "text": "Nêm muối và nước mắm vừa ăn, thả rau răm và hành lá rồi tắt bếp.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
