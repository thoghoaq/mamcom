  "steps": [
    {
      "order": 1,
      "text": "Sát muối lên cá rô rồi rửa sạch, để ráo.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-ro-dong",
        "muoi"
      ]
    },
    {
      "order": 2,
      "text": "Nhặt rửa cải xanh, cắt khúc; thái gừng, băm hành tím, thái hành lá.",
      "activeMinutes": 6,
      "passiveMinutes": 0,
      "ingredientIds": [
        "cai-xanh",
        "gung",
        "hanh-tim",
        "hanh-la"
      ]
    },
    {
      "order": 3,
      "text": "Luộc cá với gừng đập dập trong nồi nước nhỏ lửa đến khi chín.",
      "activeMinutes": 1,
      "passiveMinutes": 10,
      "ingredientIds": [
        "ca-ro-dong",
        "gung"
      ]
    },
    {
      "order": 4,
      "text": "Vớt cá ra, gỡ lấy thịt, bỏ xương; lọc nước luộc cá để riêng.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-ro-dong"
      ]
    },
    {
      "order": 5,
      "text": "Phi thơm hành tím với dầu ăn, cho thịt cá vào, nêm chút nước mắm rồi đảo nhẹ cho săn.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "ca-ro-dong",
        "nuoc-mam"
      ]
    },
    {
      "order": 6,
      "text": "Đổ nước luộc cá vào nồi, đun sôi rồi thả cải xanh và gừng sợi vào nấu chín tới.",
      "activeMinutes": 2,
      "passiveMinutes": 3,
      "ingredientIds": [
        "cai-xanh",
        "gung"
      ]
    },
    {
      "order": 7,
      "text": "Cho cá đã xào vào nồi, nêm hạt nêm và nước mắm cho vừa, tắt bếp.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-ro-dong",
        "hat-nem",
        "nuoc-mam"
      ]
    },
    {
      "order": 8,
      "text": "Múc canh ra bát, rắc hành lá và hạt tiêu.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-la",
        "hat-tieu"
      ]
    }
  ],
