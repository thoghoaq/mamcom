  "steps": [
    {
      "order": 1,
      "text": "Vo sạch gạo tẻ và gạo nếp rồi để ráo.",
      "activeMinutes": 3,
      "passiveMinutes": 10,
      "ingredientIds": [
        "gao",
        "gao-nep"
      ]
    },
    {
      "order": 2,
      "text": "Chà gà với muối và một ít gừng đập rồi rửa sạch để khử mùi.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ga-ta",
        "muoi",
        "gung"
      ]
    },
    {
      "order": 3,
      "text": "Cho gà vào nồi nước lạnh cùng gừng đập và hành tím, đun sôi rồi hạ lửa luộc đến chín, thỉnh thoảng hớt bọt.",
      "activeMinutes": 4,
      "passiveMinutes": 25,
      "ingredientIds": [
        "ga-ta",
        "gung",
        "hanh-tim"
      ]
    },
    {
      "order": 4,
      "text": "Vớt gà ra để nguội bớt, lọc giữ lại nước luộc rồi xé thịt gà thành miếng vừa ăn.",
      "activeMinutes": 10,
      "passiveMinutes": 5,
      "ingredientIds": [
        "ga-ta"
      ]
    },
    {
      "order": 5,
      "text": "Cho gạo vào nước luộc gà, nấu lửa nhỏ đến khi hạt gạo nở bung, thỉnh thoảng khuấy cho khỏi dính đáy.",
      "activeMinutes": 5,
      "passiveMinutes": 35,
      "ingredientIds": [
        "gao",
        "gao-nep"
      ]
    },
    {
      "order": 6,
      "text": "Nêm cháo với nước mắm, hạt nêm và muối cho vừa miệng.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "hat-nem",
        "muoi"
      ]
    },
    {
      "order": 7,
      "text": "Thái nhỏ hành lá, rau răm, thái sợi phần gừng còn lại và cắt chanh, ớt.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-la",
        "rau-ram",
        "gung",
        "chanh",
        "ot"
      ]
    },
    {
      "order": 8,
      "text": "Múc cháo nóng ra tô, xếp thịt gà lên trên, rắc hành lá, rau răm, gừng sợi, hành phi và tiêu, ăn kèm chanh và ớt.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ga-ta",
        "hanh-la",
        "rau-ram",
        "gung",
        "hanh-phi",
        "hat-tieu",
        "chanh",
        "ot"
      ]
    }
