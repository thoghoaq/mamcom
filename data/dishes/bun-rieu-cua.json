  "steps": [
    {
      "order": 1,
      "text": "Rửa sạch cua, bóc yếm và mai, khều gạch cua ra bát riêng.",
      "activeMinutes": 15,
      "passiveMinutes": 0,
      "ingredientIds": [
        "cua-dong"
      ]
    },
    {
      "order": 2,
      "text": "Giã hoặc xay thân cua với chút muối, hòa nước rồi lọc lấy nước cua, bỏ bã.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "cua-dong",
        "muoi"
      ]
    },
    {
      "order": 3,
      "text": "Đun nước cua lửa vừa, khuấy nhẹ một chiều đến khi riêu nổi thành mảng thì hạ nhỏ lửa.",
      "activeMinutes": 5,
      "passiveMinutes": 10,
      "ingredientIds": [
        "cua-dong"
      ]
    },
    {
      "order": 4,
      "text": "Chiên đậu phụ vàng các mặt rồi vớt ra.",
      "activeMinutes": 7,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-phu",
        "dau-an"
      ]
    },
    {
      "order": 5,
      "text": "Phi thơm hành tím, xào gạch cua với cà chua cho mềm rồi đổ vào nồi nước riêu cùng đậu chiên.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-tim",
        "dau-an",
        "ca-chua",
        "cua-dong",
        "dau-phu"
      ]
    },
    {
      "order": 6,
      "text": "Nêm nước mắm, hạt nêm và giấm cho vừa chua thanh, đun liu riu thêm vài phút.",
      "activeMinutes": 3,
      "passiveMinutes": 5,
      "ingredientIds": [
        "nuoc-mam",
        "hat-nem",
        "giam"
      ]
    },
    {
      "order": 7,
      "text": "Rửa và để ráo rau muống chẻ, rau thơm; cắt chanh, thái ớt.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "rau-muong",
        "rau-thom",
        "chanh",
        "ot"
      ]
    },
    {
      "order": 8,
      "text": "Trụng bún qua nước sôi cho vào tô, xếp riêu và đậu lên, chan nước dùng nóng, rắc hành lá, ăn kèm rau, mắm tôm, chanh và ớt.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "bun",
        "hanh-la",
        "mam-tom",
        "chanh",
        "ot",
        "rau-muong",
        "rau-thom"
      ]
    }
  ],
