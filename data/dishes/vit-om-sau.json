  "steps": [
    {
      "order": 1,
      "text": "Chà vịt với muối và gừng đập dập, rửa lại thật sạch rồi để ráo.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-vit",
        "muoi",
        "gung"
      ]
    },
    {
      "order": 2,
      "text": "Ướp vịt với nước mắm, hạt nêm, đường, hạt tiêu, một nửa hành tím và tỏi băm.",
      "activeMinutes": 3,
      "passiveMinutes": 20,
      "ingredientIds": [
        "thit-vit",
        "nuoc-mam",
        "hat-nem",
        "duong",
        "hat-tieu",
        "hanh-tim",
        "toi"
      ]
    },
    {
      "order": 3,
      "text": "Gọt khoai sọ, cắt miếng và rửa sấu trong lúc chờ ướp.",
      "activeMinutes": 6,
      "passiveMinutes": 0,
      "ingredientIds": [
        "khoai-so",
        "sau"
      ]
    },
    {
      "order": 4,
      "text": "Phi thơm phần hành tỏi và gừng sợi còn lại với dầu ăn, cho vịt vào đảo săn.",
      "activeMinutes": 6,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "toi",
        "gung",
        "thit-vit"
      ]
    },
    {
      "order": 5,
      "text": "Thêm sấu và nước xâm xấp, đun sôi rồi hạ lửa om liu riu.",
      "activeMinutes": 2,
      "passiveMinutes": 25,
      "ingredientIds": [
        "sau"
      ]
    },
    {
      "order": 6,
      "text": "Dầm nhẹ cho sấu ra vị chua, cho khoai sọ vào om tiếp đến khi khoai bở mềm.",
      "activeMinutes": 2,
      "passiveMinutes": 15,
      "ingredientIds": [
        "sau",
        "khoai-so"
      ]
    },
    {
      "order": 7,
      "text": "Nêm lại cho vừa chua mặn ngọt, rắc hành lá, rau mùi và ớt rồi tắt bếp.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-la",
        "rau-mui",
        "ot"
      ]
    }
  ],
