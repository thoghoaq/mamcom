  "steps": [
    {
      "order": 1,
      "text": "Thái mỏng thịt bò, xếp ra đĩa và để ngăn mát.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-bo-than"
      ]
    },
    {
      "order": 2,
      "text": "Rửa và xếp xà lách, rau thơm, dưa leo, khế ra đĩa rau ăn kèm.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "xa-lach",
        "rau-thom",
        "dua-leo",
        "khe"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm một nửa tỏi với dầu ăn rồi cho sả và hành tây vào đảo sơ.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "toi",
        "sa",
        "hanh-tay"
      ]
    },
    {
      "order": 4,
      "text": "Đổ nước dừa và giấm vào, nêm đường, muối rồi đun sôi liu riu cho thơm sả.",
      "activeMinutes": 2,
      "passiveMinutes": 10,
      "ingredientIds": [
        "dua",
        "giam",
        "duong",
        "muoi"
      ]
    },
    {
      "order": 5,
      "text": "Pha nước mắm với dứa băm, phần tỏi còn lại, chút đường và ớt làm nước chấm để riêng.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thom",
        "toi",
        "ot",
        "duong",
        "nuoc-mam"
      ]
    },
    {
      "order": 6,
      "text": "Đặt nồi nước giấm lên bếp lẩu, nhúng từng lát bò vừa chín tới rồi cuốn với bánh tráng, bún, rau và chấm nước mắm dứa.",
      "activeMinutes": 20,
      "passiveMinutes": 0,
