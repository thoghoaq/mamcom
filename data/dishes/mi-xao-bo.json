  "steps": [
    {
      "order": 1,
      "text": "Ướp thịt bò với một nửa tỏi, nước tương, hạt tiêu, bột năng và chút dầu ăn.",
      "activeMinutes": 3,
      "passiveMinutes": 10,
      "ingredientIds": [
        "thit-bo-than",
        "toi",
        "nuoc-tuong",
        "hat-tieu",
        "bot-nang",
        "dau-an"
      ]
    },
    {
      "order": 2,
      "text": "Trụng mì trứng trong nước sôi cho vừa mềm rồi vớt ra để ráo.",
      "activeMinutes": 3,
      "passiveMinutes": 2,
      "ingredientIds": [
        "mi-trung"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm phần tỏi còn lại, xào bò lửa lớn đến khi tái rồi trút ra đĩa.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "toi",
        "dau-an",
        "thit-bo-than"
      ]
    },
    {
      "order": 4,
      "text": "Xào cà rốt và cọng cải trước, cho lá cải vào đảo nhanh đến khi vừa chín.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-rot",
        "cai-ngot",
        "dau-an"
      ]
    },
    {
      "order": 5,
      "text": "Cho mì vào chảo cùng dầu hào, đường, đảo đều rồi trả bò vào đảo thêm một phút.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "mi-trung",
        "dau-hao",
        "duong",
        "thit-bo-than"
      ]
    },
    {
      "order": 6,
      "text": "Rắc hành lá, tắt bếp, múc ra tô và ăn kèm ớt nếu thích.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
