  "steps": [
    {
      "order": 1,
      "text": "Ngâm miến, mộc nhĩ và nấm hương trong nước ấm cho nở mềm.",
      "activeMinutes": 2,
      "passiveMinutes": 15,
      "ingredientIds": [
        "mien",
        "moc-nhi",
        "nam-huong"
      ]
    },
    {
      "order": 2,
      "text": "Thái sợi cà rốt, su hào, cắt ngắn giá và miến, thái nhỏ mộc nhĩ, nấm hương, hành lá, băm hành tím.",
      "activeMinutes": 12,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-rot",
        "su-hao",
        "gia-do",
        "mien",
        "moc-nhi",
        "nam-huong",
        "hanh-la",
        "hanh-tim"
      ]
    },
    {
      "order": 3,
      "text": "Trộn đều thịt bằm với rau củ, miến, nấm, trứng, một phần nước mắm và hạt tiêu rồi để nhân ngấm.",
      "activeMinutes": 4,
      "passiveMinutes": 10,
      "ingredientIds": [
        "thit-nac-bam",
        "trung-ga",
        "ca-rot",
        "su-hao",
        "gia-do",
        "mien",
        "moc-nhi",
        "nam-huong",
        "hanh-la",
        "hanh-tim",
        "nuoc-mam",
        "hat-tieu"
      ]
    },
    {
      "order": 4,
      "text": "Đặt nhân lên lá bánh đa nem, gấp hai mép rồi cuốn chặt tay.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "banh-da-nem",
        "thit-nac-bam"
      ]
    },
    {
      "order": 5,
      "text": "Rán nem trong dầu nóng lửa vừa, lật đều đến khi vàng giòn rồi vớt ra để ráo dầu.",
      "activeMinutes": 12,
      "passiveMinutes": 0,
      "ingredientIds": [
        "banh-da-nem",
        "dau-an"
      ]
    },
    {
      "order": 6,
      "text": "Pha nước chấm từ nước mắm, đường, giấm, nước chanh, tỏi băm và ớt.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "duong",
        "giam",
        "chanh",
        "toi",
        "ot"
      ]
    },
    {
      "order": 7,
      "text": "Dọn nem nóng kèm rau thơm và nước chấm.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "rau-thom"
      ]
    }
  ],
