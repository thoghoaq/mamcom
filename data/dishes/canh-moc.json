  "steps": [
    {
      "order": 1,
      "text": "Ngâm nấm hương và mộc nhĩ vào nước ấm cho nở mềm.",
      "activeMinutes": 2,
      "passiveMinutes": 15,
      "ingredientIds": [
        "nam-huong",
        "moc-nhi"
      ]
    },
    {
      "order": 2,
      "text": "Băm nhỏ nấm hương, mộc nhĩ và hành tím, trộn đều với giò sống, thịt bằm, một nửa nước mắm và hạt tiêu.",
      "activeMinutes": 8,
      "passiveMinutes": 10,
      "ingredientIds": [
        "nam-huong",
        "moc-nhi",
        "hanh-tim",
        "gio-song",
        "thit-nac-bam",
        "nuoc-mam",
        "hat-tieu"
      ]
    },
    {
      "order": 3,
      "text": "Gọt cà rốt, tỉa hoa và thái lát mỏng.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-rot"
      ]
    },
    {
      "order": 4,
      "text": "Đun sôi nước làm nước dùng, nêm hạt nêm và phần nước mắm còn lại rồi thả cà rốt vào.",
      "activeMinutes": 2,
      "passiveMinutes": 5,
      "ingredientIds": [
        "hat-nem",
        "nuoc-mam",
        "ca-rot"
      ]
    },
    {
      "order": 5,
      "text": "Dùng thìa nhúng nước lạnh xúc từng viên mọc thả vào nồi, giữ lửa vừa đến khi mọc nổi và chín.",
      "activeMinutes": 5,
      "passiveMinutes": 5,
      "ingredientIds": [
        "gio-song",
        "thit-nac-bam"
      ]
    },
    {
      "order": 6,
      "text": "Hớt bọt, rắc hành lá và rau mùi rồi tắt bếp.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
