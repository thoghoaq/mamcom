      "passiveMinutes": 15,
      "ingredientIds": [
        "ca-rot",
        "khoai-tay"
      ]
    },
    {
      "order": 6,
      "text": "Nêm nước mắm, hạt nêm còn lại cho vừa ăn rồi tắt bếp.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "hat-nem",
        "muoi"
      ]
    },
    {
      "order": 7,
      "text": "Múc canh ra bát, rắc hành lá, rau mùi và hạt tiêu.",
