        "ca-rot"
      ]
    },
    {
      "order": 4,
      "text": "Cho sườn vào nồi nước, đun sôi rồi hạ lửa nhỏ hầm, thỉnh thoảng hớt bọt.",
      "activeMinutes": 3,
      "passiveMinutes": 35,
      "ingredientIds": [
        "suon-non"
      ]
    },
    {
      "order": 5,
      "text": "Thả cà rốt và khoai tây vào, hầm tiếp đến khi củ mềm.",
