  "steps": [
    {
      "order": 1,
      "text": "Ướp gà với hạt nêm và hạt tiêu cho ngấm.",
      "activeMinutes": 5,
      "passiveMinutes": 15,
      "ingredientIds": [
        "ga-ta",
        "hat-nem",
        "hat-tieu"
      ]
    },
    {
      "order": 2,
      "text": "Sơ chế các loại nấm, rửa và cắt cải thảo, cải ngọt, hành lá.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nam-kim-cham",
        "nam-dui-ga",
        "nam-rom",
        "nam-huong",
        "cai-thao",
        "cai-ngot",
        "hanh-la"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm hành tím, tỏi, gừng, sả rồi cho gà vào xào săn.",
      "activeMinutes": 6,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "toi",
        "gung",
        "sa",
        "ga-ta"
      ]
    },
    {
      "order": 4,
      "text": "Đổ nước ngập, thêm nấm hương, ninh lửa nhỏ đến khi gà mềm.",
      "activeMinutes": 2,
      "passiveMinutes": 25,
      "ingredientIds": [
        "nam-huong"
      ]
    },
    {
      "order": 5,
      "text": "Nêm nước lẩu bằng nước mắm, đường và muối cho vừa miệng.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "duong",
        "muoi"
      ]
    },
    {
      "order": 6,
      "text": "Pha muối tiêu chanh với lá chanh, để ớt riêng làm chén chấm.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "muoi",
        "hat-tieu",
        "chanh",
        "la-chanh",
        "ot-hiem"
      ]
    },
    {
      "order": 7,
      "text": "Đặt nồi lẩu sôi lên bàn, nhúng nấm và rau, ăn kèm bún.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nam-kim-cham",
        "nam-dui-ga",
        "nam-rom",
        "cai-thao",
        "cai-ngot",
        "hanh-la",
        "bun"
      ]
    }
  ],
