  "steps": [
    {
      "order": 1,
      "text": "Gọt và cắt khúc củ cải, cà rốt cùng bắp ngọt.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "cu-cai",
        "ca-rot",
        "bap-ngot"
      ]
    },
    {
      "order": 2,
      "text": "Cho củ cải, cà rốt, bắp ngọt và gừng vào nồi nước, ninh lửa nhỏ để lấy nước dùng ngọt.",
      "activeMinutes": 2,
      "passiveMinutes": 30,
      "ingredientIds": [
        "cu-cai",
        "ca-rot",
        "gung",
        "bap-ngot"
      ]
    },
    {
      "order": 3,
      "text": "Trong lúc chờ, sơ chế các loại nấm, rửa và cắt cải thảo, cải ngọt, bổ cà chua.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nam-huong",
        "nam-kim-cham",
        "nam-dui-ga",
        "nam-rom",
        "cai-thao",
        "cai-ngot",
        "ca-chua"
      ]
    },
    {
      "order": 4,
      "text": "Chiên đậu phụ với dầu ăn đến khi vàng đều các mặt rồi vớt ra.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-phu",
        "dau-an"
      ]
    },
    {
      "order": 5,
      "text": "Xào sơ cà chua với chút dầu còn lại rồi đổ vào nồi nước dùng.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ca-chua",
        "dau-an"
      ]
    },
    {
      "order": 6,
      "text": "Nêm nước lẩu bằng hạt nêm chay, muối, đường và một ít nước tương cho vừa ăn.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hat-nem",
        "muoi",
        "duong",
        "nuoc-tuong"
      ]
    },
    {
      "order": 7,
      "text": "Trụng bún qua nước sôi, để ráo rồi bày ra đĩa.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "bun"
      ]
    },
    {
      "order": 8,
      "text": "Pha chén nước tương với ớt hiểm để riêng làm nước chấm.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-tuong",
        "ot-hiem"
      ]
    },
    {
      "order": 9,
      "text": "Đặt nồi lẩu lên bếp tại bàn, nhúng nấm, đậu phụ và rau khi nước sôi, ăn kèm bún.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
