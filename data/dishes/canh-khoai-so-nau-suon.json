      "passiveMinutes": 15,
      "ingredientIds": [
        "khoai-so"
      ]
    },
    {
      "order": 5,
      "text": "Nêm nước mắm, hạt nêm cho vừa miệng rồi tắt bếp.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "hat-nem"
      ]
    },
    {
      "order": 6,
      "text": "Múc canh ra bát, rắc hành lá, rau mùi và hạt tiêu.",
