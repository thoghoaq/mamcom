      ]
    },
    {
      "order": 2,
      "text": "Gọt vỏ khoai sọ, cắt miếng, ngâm nước muối loãng cho bớt nhớt.",
      "activeMinutes": 7,
      "passiveMinutes": 5,
      "ingredientIds": [
        "khoai-so",
        "muoi"
      ]
    },
    {
      "order": 3,
      "text": "Cho sườn và hành tím vào nồi nước, đun sôi, hớt bọt rồi hầm nhỏ lửa.",
      "activeMinutes": 3,
      "passiveMinutes": 25,
      "ingredientIds": [
        "suon-non",
        "hanh-tim"
      ]
    },
    {
      "order": 4,
      "text": "Thả khoai sọ vào nồi, nấu đến khi khoai chín bở.",
