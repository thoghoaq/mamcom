  "steps": [
    {
      "order": 1,
      "text": "Cạo sạch lông giò heo, chà muối, chần qua nước sôi rồi rửa lại.",
      "activeMinutes": 10,
      "passiveMinutes": 3,
      "ingredientIds": [
        "muoi",
        "gio-heo"
      ]
    },
    {
      "order": 2,
      "text": "Cho giò heo và hành tím vào nồi nước, hầm lửa nhỏ, thỉnh thoảng hớt bọt đến khi giò mềm.",
      "activeMinutes": 5,
      "passiveMinutes": 60,
      "ingredientIds": [
        "hanh-tim",
        "gio-heo"
      ]
    },
    {
      "order": 3,
      "text": "Nêm nước dùng với nước mắm, muối, đường và hạt nêm cho vừa ăn.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "muoi",
        "duong",
        "hat-nem"
      ]
    },
    {
      "order": 4,
      "text": "Thái hành lá, rau mùi, ớt và cắt chanh trong lúc chờ.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-la",
        "rau-mui",
        "ot",
        "chanh"
      ]
    },
    {
      "order": 5,
      "text": "Trụng bánh canh trong nồi nước dùng sôi rồi vớt ra tô.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "banh-canh"
      ]
    },
    {
      "order": 6,
      "text": "Xếp giò heo lên bánh canh, chan nước dùng nóng, rắc hành lá, rau mùi, hành phi, tiêu và ăn kèm ớt, chanh.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
