  "steps": [
    {
      "order": 1,
      "text": "Đeo găng tay, gọt vỏ khoai mỡ, rửa sạch rồi nạo nhuyễn một nửa, cắt hạt lựu nửa còn lại.",
      "activeMinutes": 7,
      "passiveMinutes": 0,
      "ingredientIds": [
        "khoai-mo"
      ]
    },
    {
      "order": 2,
      "text": "Bóc vỏ tôm, băm sơ rồi ướp với một ít nước mắm, hạt tiêu và hành tím băm.",
      "activeMinutes": 5,
      "passiveMinutes": 10,
      "ingredientIds": [
        "tom",
        "nuoc-mam",
        "hat-tieu",
        "hanh-tim"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm phần hành tím còn lại với dầu ăn rồi xào tôm đến khi săn và đỏ.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "tom"
      ]
    },
    {
      "order": 4,
      "text": "Cho nước vào nồi tôm, đun sôi rồi thả khoai mỡ cắt hạt lựu vào nấu đến khi mềm.",
      "activeMinutes": 2,
      "passiveMinutes": 8,
      "ingredientIds": [
        "khoai-mo"
      ]
    },
    {
      "order": 5,
      "text": "Cho khoai mỡ nạo vào, khuấy đều liên tục để canh sánh và không khét đáy.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "khoai-mo"
      ]
    },
    {
      "order": 6,
      "text": "Nêm nước mắm và hạt nêm vừa ăn, tắt bếp.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "hat-nem"
      ]
    },
    {
      "order": 7,
      "text": "Múc canh ra tô, rắc ngò gai, rau om, hành lá và hạt tiêu lên trên.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ngo-gai",
        "rau-om",
        "hanh-la",
        "hat-tieu"
      ]
    }
