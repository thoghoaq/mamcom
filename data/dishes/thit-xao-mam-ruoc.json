      ]
    },
    {
      "order": 2,
      "text": "Thái thịt thành lát mỏng, sơ chế sả, tỏi, hành tím, ớt và hành lá.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
