        "toi",
        "hanh-tim",
        "ot",
        "hanh-la"
      ]
    },
    {
      "order": 3,
      "text": "Pha mắm ruốc với chút nước và đường, khuấy tan rồi lọc lấy phần nước trong.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "mam-ruoc",
        "duong"
      ]
    },
    {
      "order": 4,
      "text": "Phi thơm sả, tỏi, hành tím và ớt với dầu ăn.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "sa",
        "toi",
        "hanh-tim",
        "ot"
      ]
    },
    {
      "order": 5,
      "text": "Cho thịt vào xào lửa vừa đến khi thịt hơi xém cạnh và ra bớt mỡ.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-ba-chi"
      ]
    },
    {
      "order": 6,
      "text": "Đổ nước mắm ruốc vào, đảo đều đến khi nước sệt lại và bám quanh thịt.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "mam-ruoc"
      ]
    },
    {
      "order": 7,
      "text": "Nêm lại cho vừa, rắc hành lá, đảo nhanh rồi tắt bếp và dọn ra ngay.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
