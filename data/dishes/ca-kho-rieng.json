        "dau-an",
        "rieng"
      ]
    },
    {
      "order": 4,
      "text": "Xếp cá cùng nước ướp lên lớp riềng, chế nước sôi xấp mặt cá rồi đun sôi.",
      "activeMinutes": 3,
      "passiveMinutes": 5,
      "ingredientIds": [
        "ca-chep"
      ]
    },
    {
      "order": 5,
      "text": "Hạ nhỏ lửa, kho liu riu không đảo cho cá săn và thấm.",
