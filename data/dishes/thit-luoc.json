  "steps": [
    {
      "order": 1,
      "text": "Rửa sạch thịt, chần qua nước sôi 2 phút rồi xả lại nước lạnh cho hết bọt bẩn.",
      "activeMinutes": 4,
      "passiveMinutes": 2,
      "ingredientIds": [
        "thit-ba-chi"
      ]
    },
    {
      "order": 2,
      "text": "Cho thịt vào nồi nước mới cùng hành tím, gừng và chút muối, đun sôi rồi hạ lửa nhỏ, hớt bọt.",
      "activeMinutes": 3,
      "passiveMinutes": 5,
      "ingredientIds": [
        "thit-ba-chi",
        "hanh-tim",
        "gung",
        "muoi"
      ]
    },
    {
      "order": 3,
      "text": "Luộc lửa nhỏ đến khi xiên đũa vào không thấy nước hồng chảy ra.",
      "activeMinutes": 0,
      "passiveMinutes": 20,
      "ingredientIds": [
        "thit-ba-chi"
      ]
    },
    {
      "order": 4,
      "text": "Tắt bếp, ngâm thịt trong nồi thêm vài phút rồi vớt ra để ráo cho thịt không bị thâm.",
      "activeMinutes": 1,
      "passiveMinutes": 5,
      "ingredientIds": [
        "thit-ba-chi"
      ]
    },
    {
      "order": 5,
      "text": "Pha nước chấm từ nước mắm, đường, nước cốt chanh, tỏi băm và ớt để riêng.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "duong",
        "chanh",
        "toi",
        "ot"
      ]
    },
    {
      "order": 6,
      "text": "Thái thịt thành lát mỏng vừa ăn, xếp ra đĩa và dọn kèm nước chấm.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-ba-chi"
      ]
    }
