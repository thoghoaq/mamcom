  "steps": [
    {
      "order": 1,
      "text": "Ngâm ngao trong nước muối loãng cho nhả hết cát.",
      "activeMinutes": 2,
      "passiveMinutes": 30,
      "ingredientIds": [
        "ngao",
        "muoi"
      ]
    },
    {
      "order": 2,
      "text": "Bóc vỏ tôm, làm sạch và cắt khoanh mực, để riêng trong đĩa.",
      "activeMinutes": 12,
      "passiveMinutes": 0,
      "ingredientIds": [
        "tom",
        "muc"
      ]
    },
    {
      "order": 3,
      "text": "Sơ chế sả, riềng, ớt, hành tím, cà chua, thơm, me, nấm và các loại rau.",
      "activeMinutes": 15,
      "passiveMinutes": 0,
      "ingredientIds": [
        "sa",
        "rieng",
        "ot-hiem",
        "hanh-tim",
        "ca-chua",
        "thom",
        "me",
        "nam-rom",
        "nam-kim-cham",
        "rau-muong",
        "cai-thao",
        "ngo-gai",
        "chanh"
      ]
    },
    {
      "order": 4,
      "text": "Phi thơm hành tím và sả với dầu rồi cho cà chua vào xào mềm.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "sa",
        "ca-chua"
      ]
    },
    {
      "order": 5,
      "text": "Đổ nước vào, thêm riềng, lá chanh, thơm và nước me rồi đun sôi liu riu.",
      "activeMinutes": 2,
      "passiveMinutes": 15,
      "ingredientIds": [
        "rieng",
        "la-chanh",
        "thom",
        "me"
      ]
    },
    {
      "order": 6,
      "text": "Nêm nước lẩu với nước mắm, đường, muối, ớt hiểm và nước cốt chanh cho vị chua cay hài hòa.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "duong",
        "muoi",
        "ot-hiem",
        "chanh"
      ]
    },
    {
      "order": 7,
      "text": "Bày bún, rau, nấm và hải sản ra đĩa, đặt nồi lẩu lên bếp để bàn.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "bun",
        "rau-muong",
        "cai-thao",
        "nam-rom",
        "nam-kim-cham",
        "tom",
        "muc",
        "ngao",
        "ngo-gai"
      ]
    },
    {
      "order": 8,
      "text": "Nhúng hải sản, nấm và rau vào nồi lẩu sôi, chín tới thì gắp ra ăn kèm bún.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "tom",
