  "steps": [
    {
      "order": 1,
      "text": "Chặt sườn thành miếng, chần qua nước sôi rồi rửa sạch.",
      "activeMinutes": 7,
      "passiveMinutes": 0,
      "ingredientIds": [
        "suon-non"
      ]
    },
    {
      "order": 2,
      "text": "Gọt vỏ sấu, khía nhẹ quanh quả; bổ cà chua, thái hành tím.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "sau",
        "ca-chua",
        "hanh-tim"
      ]
    },
    {
      "order": 3,
      "text": "Cho sườn và nước vào nồi, thêm chút muối, đun sôi rồi hớt bọt.",
      "activeMinutes": 3,
      "passiveMinutes": 5,
      "ingredientIds": [
        "suon-non",
        "muoi"
      ]
    },
    {
      "order": 4,
      "text": "Thả sấu vào, hạ lửa ninh đến khi sườn mềm và sấu chín bung.",
      "activeMinutes": 0,
      "passiveMinutes": 30,
      "ingredientIds": [
        "sau"
      ]
    },
    {
      "order": 5,
      "text": "Phi thơm hành tím với dầu, xào cà chua cho mềm rồi trút vào nồi canh.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "ca-chua"
      ]
    },
    {
      "order": 6,
      "text": "Dầm nhẹ vài quả sấu cho ra vị chua, nêm nước mắm, đường cho vừa.",
      "activeMinutes": 2,
      "passiveMinutes": 2,
      "ingredientIds": [
        "sau",
        "nuoc-mam",
        "duong"
      ]
    },
    {
      "order": 7,
      "text": "Tắt bếp, rắc hành lá và thì là rồi múc ra bát.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
