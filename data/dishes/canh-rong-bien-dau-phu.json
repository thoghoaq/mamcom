        "rong-bien"
      ]
    },
    {
      "order": 2,
      "text": "Cắt đậu phụ thành khối nhỏ, băm hành tím và thái hành lá trong lúc chờ rong biển nở.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-phu",
        "hanh-tim",
        "hanh-la"
      ]
    },
    {
      "order": 3,
      "text": "Phi thơm hành tím với dầu ăn rồi cho thịt bằm vào xào săn.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an",
        "hanh-tim",
        "thit-nac-bam"
      ]
    },
    {
      "order": 4,
      "text": "Đổ nước vào nồi, đun sôi rồi hớt bọt.",
      "activeMinutes": 1,
      "passiveMinutes": 5,
      "ingredientIds": []
    },
    {
      "order": 5,
      "text": "Thả đậu phụ vào nấu nhỏ lửa cho đậu ngấm.",
      "activeMinutes": 1,
      "passiveMinutes": 3,
      "ingredientIds": [
        "dau-phu"
      ]
    },
    {
      "order": 6,
      "text": "Cho rong biển vào, nêm nước mắm và hạt nêm, đun thêm hai phút rồi tắt bếp.",
      "activeMinutes": 1,
      "passiveMinutes": 2,
      "ingredientIds": [
        "rong-bien",
        "nuoc-mam",
        "hat-nem"
      ]
    },
    {
      "order": 7,
      "text": "Múc canh ra bát, rắc hành lá và hạt tiêu lên trên.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
