  "steps": [
    {
      "order": 1,
      "text": "Ngâm miến và mộc nhĩ trong nước ấm cho mềm.",
      "activeMinutes": 1,
      "passiveMinutes": 10,
      "ingredientIds": [
        "mien",
        "moc-nhi"
      ]
    },
    {
      "order": 2,
      "text": "Gọt và bào sợi khoai môn, cà rốt; bóc vỏ và băm tôm; băm hành tím, tỏi.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "khoai-mon",
        "ca-rot",
        "tom",
        "hanh-tim",
        "toi"
      ]
    },
    {
      "order": 3,
      "text": "Trộn thịt bằm, tôm, khoai môn, cà rốt, miến, mộc nhĩ, hành tỏi với trứng và gia vị cho đều.",
      "activeMinutes": 4,
      "passiveMinutes": 10,
      "ingredientIds": [
        "thit-nac-bam",
        "tom",
        "khoai-mon",
        "ca-rot",
        "mien",
        "moc-nhi",
        "hanh-tim",
        "toi",
        "trung-ga",
        "hat-nem",
        "hat-tieu",
        "nuoc-mam"
      ]
    },
    {
      "order": 4,
      "text": "Làm ẩm bánh tráng, đặt nhân vào rồi cuốn chặt tay, gập kín hai đầu.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "banh-trang"
      ]
    },
    {
      "order": 5,
      "text": "Chiên ngập dầu ở lửa vừa, trở đều đến khi chả giò vàng giòn rồi vớt ra để ráo dầu.",
      "activeMinutes": 12,
      "passiveMinutes": 0,
      "ingredientIds": [
        "dau-an"
      ]
    },
    {
      "order": 6,
      "text": "Pha nước mắm với đường, nước chanh, tỏi, ớt và chút nước ấm để làm nước chấm.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "duong",
        "chanh",
        "toi",
        "ot"
      ]
    },
    {
      "order": 7,
      "text": "Dọn chả giò nóng cùng rau thơm, xà lách và nước chấm.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "rau-thom",
        "xa-lach"
      ]
    }
  ],
