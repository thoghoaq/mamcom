  "steps": [
    {
      "order": 1,
      "text": "Chà gà với muối và một lát gừng, rửa sạch rồi để ráo.",
      "activeMinutes": 8,
      "passiveMinutes": 0,
      "ingredientIds": [
        "ga-ta",
        "muoi",
        "gung"
      ]
    },
    {
      "order": 2,
      "text": "Nướng gừng, hành tím và nửa củ hành tây đến khi thơm, cạo phần cháy đen.",
      "activeMinutes": 10,
      "passiveMinutes": 0,
      "ingredientIds": [
        "gung",
        "hanh-tim",
        "hanh-tay"
      ]
    },
    {
      "order": 3,
      "text": "Rang hoa hồi, quế và thảo quả trên chảo khô đến khi dậy mùi, cho vào túi lọc.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hoi",
        "que",
        "thao-qua"
      ]
    },
    {
      "order": 4,
      "text": "Cho gà, gừng và hành nướng vào nồi nước lạnh, đun sôi, hớt bọt rồi hạ lửa liu riu.",
      "activeMinutes": 5,
      "passiveMinutes": 30,
      "ingredientIds": [
        "ga-ta",
        "gung",
        "hanh-tim",
        "hanh-tay"
      ]
    },
    {
      "order": 5,
      "text": "Vớt gà ra để nguội bớt, lọc lấy thịt xé hoặc thái miếng, thả xương lại vào nồi.",
      "activeMinutes": 10,
      "passiveMinutes": 10,
      "ingredientIds": [
        "ga-ta"
      ]
    },
    {
      "order": 6,
      "text": "Thả túi gia vị vào nồi, ninh tiếp rồi nêm muối, nước mắm và đường cho vừa.",
      "activeMinutes": 3,
      "passiveMinutes": 20,
      "ingredientIds": [
        "hoi",
        "que",
        "thao-qua",
        "muoi",
        "nuoc-mam",
        "duong"
      ]
    },
    {
      "order": 7,
      "text": "Thái hành lá, rau mùi, ngò gai, lá chanh, ớt và hành tây còn lại, cắt chanh thành múi.",
      "activeMinutes": 6,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-la",
        "rau-mui",
        "ngo-gai",
        "la-chanh",
        "ot",
        "hanh-tay",
        "chanh"
      ]
    },
    {
      "order": 8,
      "text": "Trụng bánh phở qua nước sôi rồi cho vào tô.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "banh-pho"
      ]
    },
    {
      "order": 9,
      "text": "Xếp thịt gà, hành tây, hành lá, rau thơm và lá chanh lên bánh, chan nước dùng đang sôi, rắc tiêu, ăn kèm chanh ớt.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
