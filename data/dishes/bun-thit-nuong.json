  "steps": [
    {
      "order": 1,
      "text": "Trộn thịt với sả, hành tím, nửa phần tỏi, nước mắm, đường, nước màu, tiêu và chút dầu ăn.",
      "activeMinutes": 5,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-nac-vai",
        "sa",
        "hanh-tim",
        "toi",
        "nuoc-mam",
        "duong",
        "nuoc-mau",
        "hat-tieu",
        "dau-an"
      ]
    },
    {
      "order": 2,
      "text": "Ướp thịt cho thấm.",
      "activeMinutes": 0,
      "passiveMinutes": 30,
      "ingredientIds": [
        "thit-nac-vai"
      ]
    },
    {
      "order": 3,
      "text": "Bóp cà rốt và củ cải với muối, vắt ráo rồi ngâm với giấm và đường.",
      "activeMinutes": 5,
      "passiveMinutes": 20,
      "ingredientIds": [
        "ca-rot",
        "cu-cai",
        "muoi",
        "giam",
        "duong"
      ]
    },
    {
      "order": 4,
      "text": "Pha nước mắm với đường, nước chanh, tỏi còn lại, ớt và chút nước ấm cho vừa chua ngọt.",
      "activeMinutes": 4,
      "passiveMinutes": 0,
      "ingredientIds": [
        "nuoc-mam",
        "duong",
        "chanh",
        "toi",
        "ot"
      ]
    },
    {
      "order": 5,
      "text": "Rang lạc chín vàng rồi giã dập.",
      "activeMinutes": 6,
      "passiveMinutes": 0,
      "ingredientIds": [
        "lac"
      ]
    },
    {
      "order": 6,
      "text": "Đun nóng dầu, rưới lên hành lá làm mỡ hành.",
      "activeMinutes": 2,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-la",
        "dau-an"
      ]
    },
    {
      "order": 7,
      "text": "Nướng thịt trên than hoặc lò đến khi chín và xém cạnh, trở đều hai mặt.",
      "activeMinutes": 12,
      "passiveMinutes": 0,
      "ingredientIds": [
        "thit-nac-vai"
      ]
    },
    {
      "order": 8,
      "text": "Xếp rau sống, giá, dưa leo và bún vào tô, cho thịt nướng lên trên.",
      "activeMinutes": 3,
      "passiveMinutes": 0,
      "ingredientIds": [
        "xa-lach",
        "rau-thom",
        "gia-do",
        "dua-leo",
        "bun",
        "thit-nac-vai"
      ]
    },
    {
      "order": 9,
      "text": "Rưới mỡ hành, rắc lạc, thêm đồ chua và chan nước mắm rồi dọn ngay.",
      "activeMinutes": 1,
      "passiveMinutes": 0,
      "ingredientIds": [
        "hanh-la",
        "lac",
        "ca-rot",
        "cu-cai",
        "nuoc-mam"
      ]
    }
  ],
