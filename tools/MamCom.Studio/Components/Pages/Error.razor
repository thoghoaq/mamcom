@page "/Error"
@using System.Diagnostics

<PageTitle>@Strings.Studio_Error_Title</PageTitle>

<h1>@Strings.Studio_Error_Title</h1>
<p class="notice notice--danger">@Strings.Studio_Error_Message</p>

@if (ShowRequestId)
{
    <p>
        <strong>@Strings.Studio_Error_RequestId:</strong> <code>@RequestId</code>
    </p>
}

<p class="text-muted">@Strings.Studio_Error_Hint</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
