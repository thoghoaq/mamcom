@inherits LayoutComponentBase

<header class="site-header">
    <div class="site-header__inner">
        <a class="site-header__brand" href="/"><AppBrand Name="@Strings.Studio_Name" /></a>
        <nav class="site-nav" aria-label="@Strings.Studio_NavLabel">
            <NavLink href="/" Match="NavLinkMatch.All">@Strings.Studio_NavHome</NavLink>
            <NavLink href="/dishes">@Strings.Studio_NavDishes</NavLink>
            <NavLink href="/ingredients">@Strings.Studio_NavIngredients</NavLink>
        </nav>
    </div>
</header>

<main class="page">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    @Strings.Studio_ErrorBar
    <a href="." class="reload">@Strings.Studio_Reload</a>
    <span class="dismiss" role="button" tabindex="0" aria-label="@Strings.Studio_Dismiss">🗙</span>
</div>
