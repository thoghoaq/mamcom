@using MamCom.Core.Models
@using MamCom.Data.Bundles
@using MamCom.UI.Placeholders

@* The thumbnail of an ingredient when it has one, and the tile of its kind when it has none or the file cannot be shown (SPEC §7.5): never a broken image. *@
@if (Ingredient.Image.Thumb is { } thumb && !_broken)
{
    <figure class="picture picture--ingredient" title="@(Ingredient.Image.IsIllustration ? Strings.Picture_Illustration : null)">
        <img class="picture__image" src="@ThumbPreloader.ThumbUrl(thumb)" alt="" loading="lazy" @onerror="OnBroken" />
        @if (Ingredient.Image.IsIllustration)
        {
            <figcaption class="visually-hidden">@Strings.Picture_Illustration</figcaption>
        }
    </figure>
}
else
{
    <PlaceholderTile Placeholder="PlaceholderCatalog.ForIngredient(Ingredient)" Compact="true" />
}

@code {
    private bool _broken;
    private string? _shown;

    [Parameter, EditorRequired]
    public Ingredient Ingredient { get; set; } = null!;

    protected override void OnParametersSet()
    {
        // Another ingredient, or another file for the same one, gets its own chance to load.
        if (_shown != Ingredient.Image.Thumb)
        {
            _shown = Ingredient.Image.Thumb;
            _broken = false;
        }
    }

    private void OnBroken() => _broken = true;
}
