@page "/nha-minh"
@using MamCom.Core.Households
@using MamCom.Core.Models
@using MamCom.Data.State
@inherits AppDataComponentBase
@inject IHouseholdStore Households
@inject NavigationManager Navigation

<PageTitle>@Strings.Household_Title</PageTitle>

<h1>@Strings.Household_Title</h1>

@if (Data.Bundle is { } bundle && _loaded)
{
    <HouseholdSetup Portion="bundle.Config.Portion" Initial="_saved" IsFirstRun="_saved is null" Busy="_saving" OnDone="SaveAsync" OnSkip="SaveAsync" />
}

@code {
    private Household? _saved;
    private bool _loaded;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await Data.InitializeAsync();

        if (Data.Bundle is { } bundle)
        {
            // A household that was saved and cannot be used (edited by hand, or from a shape that is gone) is the same as none.
            var saved = await Households.LoadAsync();
            _saved = saved is not null && HouseholdEditor.IsUsable(saved, bundle.Config.Portion) ? saved : null;
            _loaded = true;
        }
    }

    private async Task SaveAsync(Household household)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        try
        {
            // Whether the browser keeps it is the business of the notice that every page carries; the person goes on either way.
            await Households.SaveAsync(household);
            Navigation.NavigateTo(Routes.Home);
        }
        finally
        {
            _saving = false;
        }
    }
}
